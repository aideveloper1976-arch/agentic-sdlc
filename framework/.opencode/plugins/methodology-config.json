{
  "name": "methodology-engine",
  "version": "1.0.0",
  "tdd": {
    "strictness": "hardcore",
    "overrides": {
      "allow-prototype": false,
      "allow-reference-on-first-task": false,
      "delete-before-retype": true
    }
  },
  "execution": {
    "max_concurrent_subagents": 10,
    "retry_limit": 3
  },
  "models": {
    "providers": {
      "ollama": {
        "host": "http://localhost:11434",
        "enabled": true
      },
      "openai": {
        "enabled": true,
        "apiKeyEnv": "OPENAI_API_KEY"
      },
      "deepseek": {
        "enabled": true,
        "apiKeyEnv": "DEEPSEEK_API_KEY"
      }
    },
    "profiles": {
      "default": {
        "orchestrator": {
          "provider": "auto",
          "capability": "reasoning"
        },
        "implementer": {
          "mechanical": {
            "provider": "auto",
            "capability": "fast-local"
          },
          "standard": {
            "provider": "auto",
            "capability": "code-capable"
          },
          "complex": {
            "provider": "auto",
            "capability": "reasoning"
          }
        },
        "reviewer": {
          "spec": {
            "provider": "auto",
            "capability": "code-capable"
          },
          "quality": {
            "provider": "auto",
            "capability": "code-review"
          }
        }
      },
      "local-only": {
        "orchestrator": {
          "provider": "ollama",
          "model": "auto"
        },
        "implementer": {
          "mechanical": {
            "provider": "ollama",
            "capability": "fast"
          },
          "standard": {
            "provider": "ollama",
            "capability": "code-capable"
          },
          "complex": {
            "provider": "ollama",
            "capability": "reasoning"
          }
        },
        "reviewer": {
          "spec": {
            "provider": "ollama",
            "capability": "fast"
          },
          "quality": {
            "provider": "ollama",
            "capability": "code-capable"
          }
        }
      }
    },
    "activeProfile": "default"
  }
}
