# Security MCP Server — Environment Configuration

# Scanners
TRIVY_PATH=trivy
GITLEAKS_PATH=gitleaks
PIP_AUDIT_PATH=pip-audit

# Scanning scope — defaults to process.cwd()
PROJECT_ROOT=

# Report output directory (default: docs/product/evidence)
EVIDENCE_DIR=docs/product/evidence

# Traceability MCP integration (optional)
TRACEABILITY_MCP_URL=http://localhost:3100
TRACEABILITY_MCP_TOKEN=
