# Base URL for tests (default: http://localhost)
BASE_URL=http://localhost:3000

# Comma-separated list of allowed domains (empty = localhost only)
ALLOWED_DOMAINS=

# Default timeout in milliseconds for all operations
DEFAULT_TIMEOUT_MS=30000

# Maximum navigation depth for crawling/inspection
NAVIGATION_MAX_DEPTH=5

# Run browser in headless mode (true/false)
HEADLESS=true

# Storage directories (relative to project root)
SCREENSHOT_DIR=docs/product/evidence/tests
EVIDENCE_DIR=docs/product/evidence
