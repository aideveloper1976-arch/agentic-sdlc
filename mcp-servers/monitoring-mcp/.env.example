# Monitoring MCP Configuration

# General
NODE_ENV=development
MCP_PORT=0

# Log limits
LOG_MAX_LINES=200
LOG_MAX_SIZE=1048576

# Metrics
METRICS_INTERVAL=30000

# Paths
ALERTS_DIR=./docs/product/evidence/incidents
REPORTS_DIR=./docs/product/evidence/monitoring
EVIDENCE_DIR=./docs/product/evidence

# Service access control (comma-separated, * for all)
ALLOWED_SERVICES=*

# Docker
DOCKER_ENABLED=true

# Health checks
HEALTH_TIMEOUT=5000

# Anomaly thresholds
ANOMALY_CPU_HIGH=80
ANOMALY_MEMORY_HIGH=85
ANOMALY_ERROR_SPIKE=10
ANOMALY_SLOW_RESPONSE=3000
ANOMALY_RESTART_COUNT=3
