# Web Downloader MCP — Environment Configuration

# Allowed domains for downloads (comma-separated, * = any)
ALLOWED_DOMAINS=*

# Maximum file size in bytes (default: 50MB)
MAX_FILE_SIZE=52428800

# Default download timeout in milliseconds (default: 30000)
DOWNLOAD_TIMEOUT_MS=30000

# Download directory (relative to project root, default: downloads)
DOWNLOAD_DIR=downloads

# Blocked file extensions (comma-separated)
BLOCKED_EXTENSIONS=.exe,.dll,.so,.dylib,.bat,.cmd,.ps1,.sh,.app,.msi,.jar,.class
