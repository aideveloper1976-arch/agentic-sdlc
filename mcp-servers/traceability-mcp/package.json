{
  "name": "@agentic-sdlc/traceability-mcp",
  "version": "0.1.0",
  "description": "A SQLite traceability graph from research to EPIC, feature, story, code, test and release, with evidence records, gap detection and optional Jira/Confluence sync.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "node dist/db.js",
    "sync": "node dist/sync.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/uuid": "^11.0.0"
  },
  "private": true,
  "license": "MIT"
}
