{
  "name": "@agentic-sdlc/traceability-mcp",
  "version": "0.1.0",
  "description": "A SQLite traceability graph from research to EPIC, feature, story, code, test and release, with evidence records, gap detection and optional Jira/Confluence sync.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "node dist/db.js",
    "sync": "node dist/sync.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.7",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0"
  },
  "private": true,
  "license": "MIT"
}
